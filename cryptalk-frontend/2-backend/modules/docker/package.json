{
  "name": "@cryptalk/docker-module",
  "version": "1.0.0",
  "description": "Módulo Docker isolado e modularizado",
  "main": "index.ts",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose"
  },
  "dependencies": {
    "dockerode": "^3.3.5",
    "tar-stream": "^3.1.6"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.23",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/tar-stream": "^3.1.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.test.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}