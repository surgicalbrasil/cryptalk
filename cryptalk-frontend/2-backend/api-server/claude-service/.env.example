# Configuração do Servidor
PORT=3000
WS_PORT=8080
NODE_ENV=production

# Configuração do Docker
MAX_CONTAINERS=10
CONTAINER_MAX_AGE=1800000  # 30 minutos em milliseconds

# Configuração do Claude API
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.7

# Configuração de Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Configuração de Backup
BACKUP_ENABLED=true
BACKUP_PATH=/app/backups
BACKUP_RETENTION=7  # dias

# Configuração de Tunnel (se usando Cloudflare)
TUNNEL_URL=https://your-tunnel-url.trycloudflare.com
TUNNEL_ACTIVE=false

# Configuração de Monitoramento
STATS_INTERVAL=5000      # 5 segundos
ALERT_COOLDOWN=300000    # 5 minutos
HISTORY_SIZE=100         # pontos de dados

# Configuração de Segurança
RATE_LIMIT_WINDOW=900000  # 15 minutos
RATE_LIMIT_MAX=100       # requests por window
RATE_LIMIT_CREATE_MAX=10 # criações por window

# Configuração de Recursos
RESOURCE_LIGHT_MEMORY=268435456    # 256MB
RESOURCE_LIGHT_CPU=25000           # 25% CPU
RESOURCE_MEDIUM_MEMORY=536870912   # 512MB
RESOURCE_MEDIUM_CPU=50000          # 50% CPU
RESOURCE_HEAVY_MEMORY=1073741824   # 1GB
RESOURCE_HEAVY_CPU=100000          # 100% CPU

# Configuração de Limpeza
CLEANUP_INTERVAL=600000          # 10 minutos
FORCE_KILL_TIMEOUT=30000         # 30 segundos
ORPHANED_CONTAINER_AGE=3600000   # 1 hora