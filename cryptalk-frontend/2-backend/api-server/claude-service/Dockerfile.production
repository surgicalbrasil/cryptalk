# Multi-stage build para otimização
FROM node:18-alpine AS builder

# Instalar dependências de build
RUN apk add --no-cache python3 make g++ git

# Diretório de trabalho
WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependências
RUN npm ci --only=production && npm cache clean --force

# Estágio de produção
FROM node:18-alpine

# Instalar dependências do sistema
RUN apk add --no-cache \
    dumb-init \
    curl \
    docker-cli \
    shadow \
    su-exec \
    && rm -rf /var/cache/apk/*

# Criar usuário não-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

# Criar grupo docker com GID disponível
RUN addgroup -g 998 -S docker && \
    adduser nodejs docker

# Diretório de trabalho
WORKDIR /app

# Copiar dependências do builder
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copiar código da aplicação
COPY --chown=nodejs:nodejs . .

# Criar diretórios necessários
RUN mkdir -p uploads/pending uploads/processing uploads/completed uploads/failed logs data && \
    chown -R nodejs:nodejs /app && \
    chmod -R 755 uploads logs data

# Configurar permissões executáveis
RUN chmod +x health-check.js orchestrator.js claude-analyzer.js || true

# Script de entrada inteligente
RUN cat > /usr/local/bin/docker-entrypoint.sh << 'EOF'
#!/bin/sh
set -e

# Se o socket docker estiver montado, ajustar permissões
if [ -S /var/run/docker.sock ]; then
    echo "Docker socket detected, adjusting permissions..."
    
    # Obter GID do socket docker
    DOCKER_GID=$(stat -c %g /var/run/docker.sock)
    echo "Docker socket GID: $DOCKER_GID"
    
    # Verificar se o grupo com esse GID já existe
    if ! getent group | grep -q ":${DOCKER_GID}:"; then
        echo "Creating docker-socket group with GID $DOCKER_GID"
        addgroup -g $DOCKER_GID -S docker-socket
    fi
    
    # Obter nome do grupo com esse GID
    DOCKER_GROUP=$(getent group | grep ":${DOCKER_GID}:" | cut -d: -f1)
    echo "Docker group name: $DOCKER_GROUP"
    
    # Adicionar usuário nodejs ao grupo docker
    if [ -n "$DOCKER_GROUP" ]; then
        adduser nodejs $DOCKER_GROUP
        echo "Added nodejs user to $DOCKER_GROUP group"
    fi
fi

# Executar comando como usuário nodejs
echo "Starting application as nodejs user..."
exec su-exec nodejs dumb-init -- "$@"
EOF

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expor porta
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD su-exec nodejs node health-check.js || exit 1

# Usar root para o entrypoint (necessário para ajustar permissões)
USER root

# Entrypoint customizado
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Comando padrão
CMD ["node", "orchestrator.js"]