[
  {
    "name": "high_cpu_usage",
    "condition": "cpu > 80",
    "severity": "warning",
    "duration": 300,
    "message": "High CPU usage detected",
    "description": "CPU usage is above 80% for more than 5 minutes",
    "runbook": "https://docs.cryptalk.com/runbooks/high-cpu"
  },
  {
    "name": "critical_cpu_usage",
    "condition": "cpu > 95",
