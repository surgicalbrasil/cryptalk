    "duration": 60,
    "message": "Critical CPU usage detected",
    "description": "CPU usage is above 95% for more than 1 minute",
    "runbook": "https://docs.cryptalk.com/runbooks/critical-cpu"
  },
  {
    "name": "high_memory_usage",
