{
  "name": "cryptalk-monitoring",
  "version": "1.0.0",
  "description": "Comprehensive monitoring system for CrysTalk containers",
  "main": "monitoring-service.js",
  "scripts": {
    "start": "node monitoring-service.js",
    "dev": "nodemon monitoring-service.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "redis": "^4.6.0",
    "pg": "^8.11.0",
    "nodemailer": "^6.9.0",
    "prom-client": "^14.2.0",
    "node-cron": "^3.0.2",
    "winston": "^3.10.0",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.0",
    "eslint": "^8.50.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-promise": "^6.1.0"
  },
  "keywords": [
    "monitoring",
    "docker",
    "health-checks",
    "metrics",
    "alerts",
    "dashboard",
    "prometheus",
    "grafana"
  ],
  "author": "CrysTalk Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  }
}