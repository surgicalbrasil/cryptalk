# ===========================================
# CRYPTALK PRODUCTION ENVIRONMENT
# ===========================================

# Application Configuration
NODE_ENV=production
API_URL=https://api.cryptalk.com
WS_URL=wss://api.cryptalk.com
CORS_ORIGIN=https://cryptalk.com

# Database Configuration
DB_NAME=cryptalk
DB_USER=cryptalk_user
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# Authentication & Security
JWT_SECRET=your_very_secure_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# API Keys
CLAUDE_API_KEY=your_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cloudflare Configuration
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/cryptalk.crt
SSL_KEY_PATH=/etc/ssl/private/cryptalk.key

# Monitoring Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here
GRAFANA_ROOT_URL=https://grafana.cryptalk.com

# ELK Stack Configuration
ELASTIC_PASSWORD=your_secure_elastic_password_here
KIBANA_PASSWORD=your_secure_kibana_password_here

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=noreply@cryptalk.com
ADMIN_EMAIL=admin@cryptalk.com

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_TIMEOUT=300s
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,jpg,jpeg,png,gif

# Performance Configuration
MAX_REQUESTS_PER_MINUTE=100
CONTAINER_TIMEOUT=30m
MAX_CONTAINERS=20

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BUCKET=cryptalk-backups
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Feature Flags
ENABLE_DOCUMENT_ANALYSIS=true
ENABLE_AI_REVIEWS=true
ENABLE_CRYPTO_PAYMENTS=true
ENABLE_METRICS=true
ENABLE_LOGGING=true

# Docker Configuration
DOCKER_REGISTRY=your_registry.com
DOCKER_TAG=latest
COMPOSE_PROJECT_NAME=cryptalk
COMPOSE_FILE=docker-compose.production.yml

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40s