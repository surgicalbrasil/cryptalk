# Configurações do servidor
PORT=3000
NODE_ENV=development

# URL do cliente para CORS
CLIENT_URL=http://localhost:3000

# Configurações do Docker
DOCKER_SOCKET=/var/run/docker.sock

# Configurações de segurança
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
BCRYPT_ROUNDS=12

# Configurações de rate limiting
RATE_LIMIT_POINTS=10
RATE_LIMIT_DURATION=60

# Configurações de upload
MAX_FILE_SIZE=104857600
MAX_FILES=10
UPLOAD_TIMEOUT=300000

# Configurações de container
CONTAINER_MEMORY_LIMIT=536870912
CONTAINER_CPU_QUOTA=50000
CONTAINER_TIMEOUT=3600000

# Configurações de limpeza
CLEANUP_INTERVAL=3600000
FILE_RETENTION_DAYS=7
JOB_RETENTION_HOURS=24

# Configurações de log
LOG_LEVEL=info
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# Configurações de monitoramento
HEALTH_CHECK_INTERVAL=30000
METRICS_PORT=9090

# Configurações de Redis (opcional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configurações de banco de dados (opcional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claude_code
DB_USER=claude_user
DB_PASSWORD=

# Configurações de Claude API (quando disponível)
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_API_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4000