# CrypTalk Frontend Environment Variables

# API Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WEBSOCKET_URL=ws://localhost:3001

# Production API Configuration (uncomment for production)
# REACT_APP_API_URL=https://your-production-api.com
# REACT_APP_WEBSOCKET_URL=wss://your-production-api.com

# Claude Code Integration
REACT_APP_CLAUDE_CODE_ENABLED=true
REACT_APP_CLAUDE_CODE_ENDPOINT=http://localhost:8080
REACT_APP_CLAUDE_CODE_API_KEY=your-api-key-here

# WebSocket Configuration
REACT_APP_WEBSOCKET_ENABLED=true

# Feature Flags
REACT_APP_DOCUMENT_ANALYSIS_ENABLED=true
REACT_APP_CHAT_INTERFACE_ENABLED=true
REACT_APP_REAL_TIME_ANALYSIS_ENABLED=true
REACT_APP_MULTI_AGENT_SUPPORT_ENABLED=true

# File Upload Limits (50MB default)
REACT_APP_MAX_FILE_SIZE=52428800
REACT_APP_MAX_FILES_PER_UPLOAD=5

# Auth Configuration
REACT_APP_AUTH_ENABLED=true
REACT_APP_MAGIC_PUBLISHABLE_KEY=your-magic-key-here

# Web3 Storage Configuration
REACT_APP_WEB3_STORAGE_TOKEN=your-web3-storage-token-here

# Development/Production Mode
NODE_ENV=development
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=debug

# Production Configuration (set NODE_ENV=production for production)
# NODE_ENV=production
# REACT_APP_DEBUG=false
# REACT_APP_LOG_LEVEL=error