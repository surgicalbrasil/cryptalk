{
  "name": "cryptalk-modular",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "CrypTalk - Estrutura Modular Profissional com Arquitetura Verdadeiramente Modular",
  "scripts": {
    "dev": "cd 1-frontend && npm run dev",
    "build": "cd 1-frontend && npm run build",
    "vercel-build": "cd 1-frontend && npm install && npm run build",
    "backend": "cd 2-backend && npx ts-node orchestrator.ts",
    "backend:old": "cd 2-backend/api-server/claude-service && node orchestrator.js",
    "start": "concurrently \"npm run backend\" \"npm run dev\"",
    "start:old": "concurrently \"npm run backend:old\" \"npm run dev\"",
    "install-all": "cd 1-frontend && npm install && cd ../2-backend && npm install",
    "setup": "npm run install-all && chmod +x 4-scripts/deployment/*.sh",
    "docker:up": "cd 3-config/docker && docker-compose up -d",
    "docker:down": "cd 3-config/docker && docker-compose down",
    "docker:logs": "cd 3-config/docker && docker-compose logs -f",
    "clean": "rm -rf 1-frontend/node_modules 2-backend/node_modules 5-storage/builds",
    "tunnel:setup": "node 4-scripts/automation/setup-tunnel.cjs",
    "tunnel:start": "./4-scripts/automation/start-tunnel.sh",
    "deploy": "./4-scripts/deployment/deploy.sh",
    "security": "./4-scripts/security/emergency-security-lockdown.sh",
    "test": "cd 2-backend && npm test",
    "test:modules": "npm run test:docker && npm run test:claude && npm run test:upload && npm run test:websocket",
    "test:docker": "cd 2-backend/modules/docker && npm test",
    "test:claude": "cd 2-backend/modules/claude && npm test", 
    "test:upload": "cd 2-backend/modules/upload && npm test",
    "test:websocket": "cd 2-backend/modules/websocket && npm test",
    "health": "curl -s http://localhost:3002/api/health | jq",
    "status": "curl -s http://localhost:3002/api/status | jq",
    "validate": "cd 2-backend && npx tsc --noEmit",
    "migrate": "npm run backend:old & sleep 5 && npm run backend && killall node"
  },
  "workspaces": [
    "1-frontend",
    "2-backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "cryptalk",
    "modular-architecture", 
    "typescript",
    "docker",
    "claude-ai",
    "websocket",
    "dependency-injection"
  ],
  "author": "CrypTalk Team",
  "license": "MIT"
}