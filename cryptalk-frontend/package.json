{
  "name": "cryptalk-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "upload-server": "node upload-server.js",
    "vercel-build": "npm install && npm run build",
    "setup": "chmod +x scripts/setup.sh && ./scripts/setup.sh",
    "deploy": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh",
    "start": "npm run dev",
    "clean": "rm -rf node_modules dist && npm install",
    "server": "node server/server.js",
    "server:hybrid": "node server/server-hybrid.js",
    "server:prod": "NODE_ENV=production node server/server-hybrid.js",
    "tunnel:setup": "node scripts/setup-tunnel.js",
    "tunnel:start": "./scripts/start-tunnel.sh",
    "tunnel:stop": "./scripts/stop-tunnel.sh",
    "tunnel:status": "./scripts/tunnel-status.sh",
    "hybrid:start": "concurrently \"npm run server:hybrid\" \"npm run tunnel:start\"",
    "hybrid:dev": "concurrently \"npm run dev\" \"npm run server:hybrid\" \"npm run tunnel:start\"",
    "build:prod": "NODE_ENV=production npm run build",
    "deploy:frontend": "npm run build:prod && ./scripts/deploy-frontend.sh",
    "deploy:full": "npm run build:prod && ./scripts/deploy-full.sh",
    "tunnel:revert": "node scripts/revert-tunnel.js",
    "tunnel:test": "node scripts/test-tunnel-connection.cjs",
    "build:tunnel": "npm run tunnel:setup && npm run build",
    "dev:tunnel": "npm run tunnel:setup && npm run dev",
    "preview:tunnel": "npm run tunnel:setup && npm run preview"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.0.19",
    "@chakra-ui/react": "^2.7.1",
    "@chakra-ui/system": "^2.5.8",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@magic-sdk/provider": "^29.2.0",
    "@types/react-dropzone": "^5.1.0",
    "@ucanto/principal": "^9.0.2",
    "@web3-storage/access": "^20.3.0",
    "@web3-storage/w3up-client": "^17.3.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.5.0",
    "ethers": "^6.7.1",
    "express": "^5.1.0",
    "framer-motion": "^10.13.1",
    "isomorphic-ws": "^5.0.0",
    "magic-sdk": "^29.2.0",
    "multer": "^2.0.0",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.44.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "eslint": "^8.44.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "globals": "^13.20.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^0.0.1-alpha.0",
    "vite": "^4.4.4"
  }
}