# Configurações Docker para CrysTalk
# ===================================

# Configurações do Node.js
NODE_ENV=production
PORT=3000

# Configurações do Docker
DOCKER_SOCKET=/var/run/docker.sock

# Configurações do Claude/Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_COMMAND=claude

# Configurações do Redis
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379

# Configurações do PostgreSQL
DB_NAME=claude_code
DB_USER=claude_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=postgres
DB_PORT=5432

# Configurações do Grafana
GRAFANA_PASSWORD=your_grafana_password_here

# Configurações de Monitoramento
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_URL=http://localhost:3000/health

# Configurações de Segurança
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Configurações de Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/app/uploads

# Configurações de Rede
CLAUDE_NETWORK_SUBNET=172.20.0.0/16
WEBSOCKET_PORT=8080

# Configurações de Container
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5
CONTAINER_TIMEOUT=1800000

# Configurações de Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Configurações de Tunnel (se usando Cloudflare)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
TUNNEL_NAME=crystalk-tunnel

# Configurações de Desenvolvimento
DEBUG=false
VERBOSE_LOGGING=false

# Configurações de Produção
ENABLE_CORS=true
CORS_ORIGIN=https://your-domain.com
ENABLE_HTTPS=false
SSL_CERT_PATH=/etc/ssl/certs/nginx-selfsigned.crt
SSL_KEY_PATH=/etc/ssl/private/nginx-selfsigned.key