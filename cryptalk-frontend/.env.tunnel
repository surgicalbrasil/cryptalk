# Configurações do Tunnel Cloudflare para CrypTalk
# ================================================

# URLs do tunnel
VITE_API_URL=https://furthermore-decide-para-ste.trycloudflare.com
VITE_WEBSOCKET_URL=wss://furthermore-decide-para-ste.trycloudflare.com
VITE_TUNNEL_URL=https://furthermore-decide-para-ste.trycloudflare.com

# Configurações do backend local (para referência)
BACKEND_LOCAL_URL=http://localhost:3001
BACKEND_LOCAL_WS=ws://localhost:8080

# Configurações de ambiente
NODE_ENV=production
VITE_APP_MODE=tunnel
VITE_ENVIRONMENT=tunnel

# Configurações de segurança
VITE_CORS_ENABLED=true
VITE_SSL_ENABLED=true

# Configurações de timeout
VITE_REQUEST_TIMEOUT=30000
VITE_WEBSOCKET_TIMEOUT=300000
VITE_CONNECTION_RETRY=5

# Configurações de desenvolvimento
VITE_DEBUG=false
VITE_VERBOSE_LOGGING=false

# Configurações específicas do tunnel
VITE_TUNNEL_ACTIVE=true
VITE_LOCAL_DEVELOPMENT=false
VITE_BYPASS_CORS=true